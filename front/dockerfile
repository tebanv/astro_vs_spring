# ETAPA 1: Construcción
FROM oven/bun:1.1-alpine AS build
WORKDIR /app

# Copiamos los archivos de configuración
COPY project-a/package.json ./
# Eliminamos el lockfile viejo por si tiene rutas rotas o errores de 2023
RUN rm -f bun.lockb 

# Instalamos desde cero DENTRO de Docker (aquí el 404 no debería existir)
RUN bun install

# Ahora sí, copiamos el resto del código de project-a
COPY project-a/ .

# Construimos el proyecto Astro
RUN bun run build

# ETAPA 2: Runtime (Imagen ultra ligera)
FROM oven/bun:1.1-alpine AS runtime
WORKDIR /app

# Copiamos solo lo necesario para que el servidor corra
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

# Exponemos el puerto de Astro
EXPOSE 4321

# Comando para iniciar el servidor de Bun generado por Astro
CMD ["bun", "./dist/server/entry.mjs"]