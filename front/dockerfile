# ETAPA 1: Construcción
FROM oven/bun:1-alpine AS build
WORKDIR /app

# Copiamos los archivos desde project-a (que ahora es nuestra raíz)
COPY package.json bun.lockb ./
RUN bun install --frozen-lockfile

COPY . .

# Esto generará la carpeta /dist
RUN bun run build

# ETAPA 2: Runtime
FROM oven/bun:1-distroless AS runtime
WORKDIR /app

# Copiamos lo necesario para ejecutar el servidor
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/server.ts ./ 

# EXPOSE el puerto que definiste en server.ts
EXPOSE 4321

# Si usas Elysia/Server.ts, el comando suele ser este:
CMD ["bun", "run", "server.ts"]
# O si Astro genera un entrypoint:
# CMD ["bun", "run", "dist/server/entry.mjs"]