# ---------- BUILD STAGE ----------
FROM oven/bun:1 AS builder

WORKDIR /app

COPY package.json bun.lockb* ./
RUN bun install

COPY . .

RUN bun run build


# ---------- RUNTIME STAGE ----------
FROM oven/bun:1-slim

WORKDIR /app

# Solo copiamos lo necesario
COPY --from=builder /app .

EXPOSE 4321

CMD ["bun", "dist/server/entry.mjs" ]