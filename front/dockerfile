# ETAPA 1: Construcción
FROM oven/bun:1.1-alpine AS build
WORKDIR /app

# 1. Copiamos el package.json (ya estamos dentro de project-a según el compose)
COPY package.json ./

# 2. Limpieza y Reinstalación fresca
RUN rm -f bun.lockb 
RUN bun install

# 3. Copiamos el resto del código fuente
COPY . .

# 4. Construimos el proyecto Astro
RUN bun run build

# ETAPA 2: Runtime
FROM oven/bun:1.1-alpine AS runtime
WORKDIR /app

# Copiamos solo lo necesario del build
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

EXPOSE 4321

# Comando para iniciar el servidor de Bun generado por Astro
CMD ["bun", "./dist/server/entry.mjs"]