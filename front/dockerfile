# ETAPA 1: Construcción
FROM node:20-alpine AS build
WORKDIR /app

# Instalamos Bun
RUN npm install -g bun

# Copiamos package.json
COPY package.json ./

# --- MANIOBRA DE EVASIÓN ---
# Usamos el registro de Yarn o Cloudflare que suelen ser más resilientes
RUN npm config set registry https://registry.yarnpkg.com/
# Intentamos instalar con flags de limpieza
RUN npm install --no-package-lock --verbose || npm install --registry=https://registry.npmjs.org/

# Si lo anterior pasa, seguimos con Bun
COPY . .
RUN bun run build

# ETAPA 2: Runtime
FROM oven/bun:1.1-alpine AS runtime
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

EXPOSE 4321
CMD ["bun", "./dist/server/entry.mjs"]