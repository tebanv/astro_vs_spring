/node_modules/
/.pnp/
/.pnp.js

# Package manager lockfiles (uncomment si usas uno específico)
/package-lock.json
/pnpm-lock.yaml
/yarn.lock

# Build and output directories
/dist/
/.out/
/.next/
/.vercel/
/.netlify/
.astro/
.bun/

# Environment files
.env
.env.local
.env.*.local

# Miscellaneous
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bun cache
.bun/

