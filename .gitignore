*.class
*.jar
*.war
*.nar
*.ear

# Build artifacts
/target/
/build/
/out/

# IDEs and Editors
/.idea/
/.vscode/
/*.iml

# Logs and temp files
*.log
/logs/
/hs_err_pid*
/replay_pid*

